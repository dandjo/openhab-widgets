# huawei_modbus_proxy's settings, read by the systemd unit as its EnvironmentFile (NAME=value, no spaces around =)
# the dongle's host[:port], port 502 if left out
HUAWEI_MODBUS_PROXY_DONGLE=192.0.2.10:502
# where the clients connect; keep it local, Modbus knows no authentication
HUAWEI_MODBUS_PROXY_LISTEN=127.0.0.1:5502
# the rest have defaults (see the README), e.g. the seconds for the dongle's answer
#HUAWEI_MODBUS_PROXY_ANSWER_TIMEOUT=5.0
